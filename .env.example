# App Configuration
NEXT_PUBLIC_BASE_URL=http://uddoktahut.local:3000
NEXT_PUBLIC_BACKEND_API=http://api.uddoktahut.local:4000
NEXT_PUBLIC_ENV=development

# JWT Configuration
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_TOKEN=your-refresh-token-secret-here

# Local only: pretend to visit from this country (BD or AU). Ignored in production.
DEV_IP_COUNTRY=AU

# Production Example:
# NEXT_PUBLIC_BASE_URL=https://your-domain.com
# NEXT_PUBLIC_BACKEND_API=https://api.your-domain.com
# NEXT_PUBLIC_ENV=production